<Window x:Class="KW.CameraSimulatorTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Simulator" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Port:" VerticalAlignment="Center" Foreground="White" Margin="0,0,8,0"/>
                <TextBox x:Name="PortBox" Text="{Binding Port}" Width="80" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button x:Name="StartBtn" Content="Start Server" Width="120" Click="StartBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="StopBtn" Content="Stop Server" Width="120" Click="StopBtn_Click"/>
                <TextBlock Text="{Binding ServerStatus}" VerticalAlignment="Center" Foreground="#4EC9B0" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#1E1E1E" Padding="8" Height="150">
            <DockPanel>
                <TextBlock Text="Log:" Foreground="#CCCCCC" DockPanel.Dock="Top" Margin="0,0,0,4"/>
                <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" Background="#252526" Foreground="#DCDCDC"
                         FontFamily="Consolas" FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>

        <Grid Background="#252526" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Virtual Cameras" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,4,0,8"/>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Cameras}" AutoGenerateColumns="False"
                      Background="#2D2D30" Foreground="White" RowBackground="#333337"
                      AlternatingRowBackground="#2D2D30" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3F3F46">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="120"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="160"/>
                    <DataGridTextColumn Header="Width" Binding="{Binding Width}" Width="70"/>
                    <DataGridTextColumn Header="Height" Binding="{Binding Height}" Width="70"/>
                    <DataGridTextColumn Header="Target FPS" Binding="{Binding Fps}" Width="80"/>
                    <DataGridTextColumn Header="Actual FPS" Binding="{Binding ActualFps, StringFormat=F1}" Width="90"/>
                    <DataGridTextColumn Header="Frames" Binding="{Binding FramesSent}" Width="100"/>
                    <DataGridTextColumn Header="Streaming" Binding="{Binding IsStreaming}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>