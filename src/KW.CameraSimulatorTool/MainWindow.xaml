<Window x:Class="KW.CameraSimulatorTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Simulator" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1976D2" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Basler Camera Emulation (PYLON_CAMEMU)" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock x:Name="EmulationStatusTextBlock"
                           Text="{Binding EmulationStatus}"
                           Foreground="#B3E5FC" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="#E3F2FD" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Emulated Cameras:" VerticalAlignment="Center" Foreground="#1565C0" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding EmulatedCount}" Width="50" VerticalAlignment="Center" Margin="0,0,16,0" IsEnabled="{Binding IsServerStopped}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Enable" Width="80" Command="{Binding EnableEmulationCommand}" Margin="0,0,6,0" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                    <Button Content="Disable" Width="80" Command="{Binding DisableEmulationCommand}" Background="#F44336" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="KWinSprint.exe:" VerticalAlignment="Center" Foreground="#1565C0" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding KWinSprintPath}" Width="260" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="Launch KWinSprint" Width="130" Command="{Binding LaunchKWinSprintCommand}" Background="#FF9800" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="12" BorderBrush="#3E3E42" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding BindAddressDisplay}" Foreground="#999999" FontSize="10" Margin="0,0,0,4"/>
                <TextBlock DockPanel.Dock="Top" Text="TCP Server" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,6"/>
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Port:" VerticalAlignment="Center" Foreground="White" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding Port}" Width="80" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <CheckBox Grid.Column="2" Content="Allow remote connections" IsChecked="{Binding AllowRemoteConnections}" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Grid.Column="3" Content="Start Server" Width="120" Click="StartBtn_Click" Margin="0,0,8,0"/>
                <Button Grid.Column="4" Content="Stop Server" Width="120" Click="StopBtn_Click"/>
                <TextBlock Grid.Column="5" Text="{Binding ServerStatus}" VerticalAlignment="Center" Foreground="#4EC9B0" Margin="16,0,0,0"/>
                </Grid>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#1E1E1E" Padding="8" Height="150">
            <DockPanel>
                <TextBlock Text="Log:" Foreground="#CCCCCC" DockPanel.Dock="Top" Margin="0,0,0,4"/>
                <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" Background="#252526" Foreground="#DCDCDC"
                         FontFamily="Consolas" FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>

        <Grid Background="#252526" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,8">
                <TextBlock Text="Virtual Cameras" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="  (Width/Height/Fps/TestPattern are editable — changes require server restart)"
                           Foreground="#888888" FontSize="10" VerticalAlignment="Center"/>
            </StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Cameras}" AutoGenerateColumns="False"
                      Background="#2D2D30" Foreground="White" RowBackground="#333337"
                      AlternatingRowBackground="#2D2D30" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3F3F46">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#333337"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                <Setter Property="Background" Value="#5C1A1A"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                <Setter Property="Background" Value="#1A3A2A"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Width" Binding="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    <DataGridTextColumn Header="Height" Binding="{Binding Height, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    <DataGridTextColumn Header="Target FPS" Binding="{Binding Fps, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    <DataGridComboBoxColumn Header="Test Pattern"
                                            SelectedItemBinding="{Binding TestPattern}"
                                            ItemsSource="{Binding DataContext.TestPatterns, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Width="120"/>
                    <DataGridTextColumn Header="Actual FPS" Binding="{Binding ActualFps, StringFormat=F1}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Frames Sent" Binding="{Binding FramesSent}" Width="90" IsReadOnly="True"/>
                    <DataGridCheckBoxColumn Header="Streaming" Binding="{Binding IsStreaming}" Width="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Validation" Binding="{Binding ValidationError}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>