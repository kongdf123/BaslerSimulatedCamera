<!-- 在其后追加： -->

<Button x:Name="AddSimulatedCameraButton"
        Margin="8,0,0,0"
        Padding="12,0,4,0"
        HorizontalAlignment="Left"
        Command="{Binding AddSimulatedCameraCommand}">
    <StackPanel Orientation="Horizontal">
        <Path Data="{StaticResource Icon_Add_Style}"
              Width="12" Height="12"
              Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <TextBlock Text="添加模拟相机" Margin="4,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
</Button>